{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openprose.org/echo/v0/terminal-envelope.schema.json",
  "title": "OpenProse nonsemantic echo-placeholder terminal envelope",
  "description": "Transport completion only. It makes no OpenProse execution or semantic-success claim.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "semanticStatus", "placeholder", "marker", "task"],
  "properties": {
    "schema": { "const": "openprose.echo-terminal/1" },
    "semanticStatus": { "const": "not-applicable" },
    "placeholder": { "const": true },
    "marker": { "const": "OPENPROSE_ECHO_TERMINAL_V0" },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    }
  }
}
