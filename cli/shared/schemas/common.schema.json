{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openprose.org/cli/v1/common.schema.json",
  "title": "OpenProse runner common scalar definitions",
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "rfc3339": { "type": "string", "format": "date-time" },
    "guarantee": {
      "type": "string",
      "enum": ["enforced", "advisory", "unsupported"]
    },
    "runtime": {
      "type": "string",
      "enum": [
        "installed-process",
        "sdk-managed-process",
        "embedded-runtime",
        "hosted-runtime",
        "deterministic-mock"
      ]
    },
    "billingOwner": {
      "type": "string",
      "enum": ["openprose", "user-provider", "test-fixture"]
    },
    "authCategory": {
      "type": "string",
      "enum": [
        "openprose-account",
        "harness-managed",
        "provider-api",
        "cloud-provider",
        "openrouter",
        "none-test-only"
      ]
    },
    "runtimePrerequisiteObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "versionRange", "detectedVersion", "availability", "repairCommand"],
      "properties": {
        "runtime": { "const": "bun" },
        "versionRange": { "const": ">=1.3.14" },
        "detectedVersion": {
          "type": ["string", "null"],
          "pattern": "^(?:0|[1-9][0-9]{0,5}|1000000)\\.(?:0|[1-9][0-9]{0,5}|1000000)\\.(?:0|[1-9][0-9]{0,5}|1000000)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "availability": { "enum": ["available", "missing", "incompatible"] },
        "repairCommand": {
          "const": "npm install --global bun@1.3.14 @oh-my-pi/pi-coding-agent@18.0.9"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "availability": { "const": "missing" } } },
          "then": { "properties": { "detectedVersion": { "const": null } } }
        },
        {
          "if": { "properties": { "availability": { "const": "available" } } },
          "then": {
            "properties": {
              "detectedVersion": {
                "type": "string",
                "pattern": "^(?:(?:[2-9]|[1-9][0-9]{1,5}|1000000)\\.(?:0|[1-9][0-9]{0,5}|1000000)\\.(?:0|[1-9][0-9]{0,5}|1000000)|1\\.(?:[4-9]|[1-9][0-9]{1,5}|1000000)\\.(?:0|[1-9][0-9]{0,5}|1000000)|1\\.3\\.(?:1[4-9]|[2-9][0-9]|[1-9][0-9]{2,5}|1000000))$"
              }
            }
          }
        }
      ]
    },
    "platform": {
      "type": "string",
      "pattern": "^(darwin|linux|win32)-[a-z0-9_]+(?:-(?:gnu|musl))?$"
    },
    "jsonValue": {
      "type": ["null", "boolean", "number", "string", "array", "object"]
    }
  }
}
