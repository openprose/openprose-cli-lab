{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openprose.org/cli/v1/runner-dry-run-report.schema.json",
  "title": "OpenProse no-execution dry-run report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "wouldStartModel", "cwd", "selection", "prompt", "isolation",
    "auth", "billingOwner", "languageImage", "configuration", "readiness",
    "blockingError"
  ],
  "properties": {
    "nativeLimits": { "$ref": "native-limits.schema.json" },
    "nativeOutputLimits": { "$ref": "native-output-limits.schema.json" },
    "nativeConfiguration": { "$ref": "native-configuration.schema.json" },
    "schema": { "const": "openprose.runner-dry-run-report/1" },
    "wouldStartModel": { "const": false },
    "cwd": { "type": "string", "minLength": 1 },
    "selection": {
      "type": "object", "additionalProperties": false,
      "required": ["harness", "transport", "adapterId", "runtimeVersion", "model"],
      "properties": {
        "harness": { "type": "string", "minLength": 1 },
        "transport": { "type": "string", "minLength": 1 },
        "adapterId": { "type": "string", "minLength": 1 },
        "runtimeVersion": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] }
      }
    },
    "prompt": {
      "type": "object", "additionalProperties": false,
      "required": ["placement", "strictness"],
      "properties": { "placement": { "type": ["string", "null"] }, "strictness": { "enum": ["strict", "degraded", "unsupported"] } }
    },
    "isolation": { "enum": ["managed-policy-preserving", "partial", "unsupported", "test-fixture"] },
    "auth": {
      "type": "object", "additionalProperties": false,
      "required": ["category", "readiness"],
      "properties": { "category": { "$ref": "common.schema.json#/$defs/authCategory" }, "readiness": { "enum": ["ready", "required", "unknown", "not-applicable"] } }
    },
    "billingOwner": { "$ref": "common.schema.json#/$defs/billingOwner" },
    "languageImage": {
      "type": "object", "additionalProperties": false,
      "required": ["formatVersion", "version", "sha256", "releaseEligible"],
      "properties": { "formatVersion": { "const": "openprose.skill-runtime-image/1" }, "version": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "common.schema.json#/$defs/sha256" }, "releaseEligible": { "type": "boolean" } }
    },
    "configuration": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["key", "source", "location", "redacted"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "source": { "enum": ["flag", "environment", "project", "user", "default"] },
          "location": { "type": ["string", "null"] },
          "redacted": { "type": "boolean" }
        }
      }
    },
    "readiness": { "enum": ["ready", "blocked"] },
    "blockingError": { "anyOf": [{ "$ref": "runner-error.schema.json" }, { "type": "null" }] }
  }
}
