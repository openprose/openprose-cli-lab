{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://schemas.openprose.org/cli/v1/native-limits.schema.json",
  "required": [
    "maxTurns",
    "timeoutSeconds",
    "toolTimeoutSeconds",
    "maxOutputTokens"
  ],
  "properties": {
    "maxTurns": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "timeoutSeconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740.99
    },
    "toolTimeoutSeconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740.99
    },
    "maxOutputTokens": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  }
}
