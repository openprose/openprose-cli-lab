{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openprose.org/cli/v1/benchmark-policy.schema.json",
  "title": "OpenProse benchmark policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "policyId", "policyVersion", "frozenAt", "warmups",
    "repetitions", "randomizedPairing", "timeoutAccounting",
    "noOutlierDrop", "retainFailures", "confidence", "machineQualification",
    "regressionBudgets", "holdout", "residualTiming"
  ],
  "properties": {
    "schema": { "const": "openprose.benchmark-policy/1" },
    "policyId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
    "policyVersion": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "frozenAt": { "$ref": "common.schema.json#/$defs/rfc3339" },
    "warmups": { "type": "integer", "minimum": 0 },
    "repetitions": { "type": "integer", "minimum": 1 },
    "randomizedPairing": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "seedSource", "recordSeed"],
      "properties": { "enabled": { "const": true }, "seedSource": { "enum": ["profile-fixed", "ceremony-generated"] }, "recordSeed": { "const": true } }
    },
    "timeoutAccounting": {
      "type": "object", "additionalProperties": false,
      "required": ["perRunMs", "timeoutsCountAsFailures", "includeElapsed"],
      "properties": { "perRunMs": { "type": "integer", "minimum": 1 }, "timeoutsCountAsFailures": { "const": true }, "includeElapsed": { "const": true } }
    },
    "noOutlierDrop": { "const": true },
    "retainFailures": { "const": true },
    "confidence": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "level", "resamples"],
      "properties": { "method": { "enum": ["paired-bootstrap", "bootstrap", "student-t"] }, "level": { "type": "number", "exclusiveMinimum": 0.5, "exclusiveMaximum": 1 }, "resamples": { "type": "integer", "minimum": 100 } }
    },
    "machineQualification": {
      "type": "object", "additionalProperties": false,
      "required": ["recordOs", "recordArch", "recordCpu", "recordMemory", "recordLoad", "maximumLoadAveragePerCore"],
      "properties": { "recordOs": { "const": true }, "recordArch": { "const": true }, "recordCpu": { "const": true }, "recordMemory": { "const": true }, "recordLoad": { "const": true }, "maximumLoadAveragePerCore": { "type": "number", "minimum": 0 } }
    },
    "regressionBudgets": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["metric", "direction", "maximumRelativeRegression"],
        "properties": { "metric": { "type": "string", "minLength": 1 }, "direction": { "enum": ["lower-is-better", "higher-is-better"] }, "maximumRelativeRegression": { "type": "number", "minimum": 0 } }
      }
    },
    "holdout": {
      "type": "object", "additionalProperties": false,
      "required": ["requiredForPublicClaims", "protectedExternally", "identityHiddenFromImplementations"],
      "properties": { "requiredForPublicClaims": { "const": true }, "protectedExternally": { "const": true }, "identityHiddenFromImplementations": { "const": true } }
    },
    "residualTiming": {
      "type": "object", "additionalProperties": false,
      "required": ["publishOnlyWithCompleteSpans", "requireCommonOrCorrelatedClock", "fallback"],
      "properties": { "publishOnlyWithCompleteSpans": { "const": true }, "requireCommonOrCorrelatedClock": { "const": true }, "fallback": { "const": "publish-components-without-subtraction" } }
    }
  }
}
