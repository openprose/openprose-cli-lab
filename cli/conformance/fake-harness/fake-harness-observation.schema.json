{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openprose.org/cli-conformance/v1/fake-harness-observation.schema.json",
  "title": "Independent fake harness input observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "scenario", "argv", "cwd", "image", "task", "environment"],
  "properties": {
    "schema": { "const": "openprose.fake-harness-observation/1" },
    "scenario": {
      "enum": ["success", "malformed", "truncated", "eof-without-terminal", "nonzero", "terminal-nonzero", "delay", "stderr", "fragmented", "crlf", "duplicate-terminal", "reordered", "descendant"]
    },
    "argv": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "cwd": { "type": "string", "minLength": 1 },
    "image": { "$ref": "#/$defs/observedBytes" },
    "task": { "$ref": "#/$defs/observedBytes" },
    "environment": {
      "type": "object",
      "propertyNames": { "enum": ["OPENPROSE_INVOCATION_ID", "OPENPROSE_RECURSION_TOKEN", "OPENPROSE_RUN_NONCE"] },
      "additionalProperties": { "type": "string" }
    }
  },
  "$defs": {
    "observedBytes": {
      "type": "object", "additionalProperties": false,
      "required": ["byteLength", "sha256", "bytesBase64"],
      "properties": {
        "byteLength": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "bytesBase64": { "type": "string", "pattern": "^[A-Za-z0-9+/]*={0,2}$" }
      }
    }
  }
}
