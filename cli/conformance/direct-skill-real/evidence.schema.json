{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openprose.dev/schemas/direct-skill-real-evidence-v1.json",
  "title": "OpenProse direct legacy-skill observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "matrixId",
    "matrixSha256",
    "policyId",
    "policySha256",
    "route",
    "program",
    "harness",
    "skill",
    "taskSha256",
    "isolation",
    "process",
    "toolAudit",
    "workspace",
    "observation",
    "claims"
  ],
  "properties": {
    "schema": { "const": "openprose.direct-skill-real-evidence/1" },
    "matrixId": { "type": "string", "minLength": 1 },
    "matrixSha256": { "$ref": "#/$defs/sha256" },
    "policyId": { "type": "string", "minLength": 1 },
    "policySha256": { "$ref": "#/$defs/sha256" },
    "taskSha256": { "$ref": "#/$defs/sha256" },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "provider", "model"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "provider": { "$ref": "#/$defs/nonEmptyString" },
        "model": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256", "trial"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "trial": { "type": "integer", "minimum": 1, "maximum": 2 }
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "observedVersion", "executableSha256"],
      "properties": {
        "name": { "const": "prime-agent" },
        "observedVersion": { "$ref": "#/$defs/nonEmptyString" },
        "executableSha256": { "$ref": "#/$defs/sha256" },
        "executionCustody": { "$ref": "#/$defs/executionCustody" }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "treeSha256",
        "fileCount",
        "totalBytes",
        "relevantFiles"
      ],
      "properties": {
        "classification": { "const": "explicit-installed-legacy-skill" },
        "treeSha256": { "$ref": "#/$defs/sha256" },
        "fileCount": { "type": "integer", "minimum": 1 },
        "totalBytes": { "type": "integer", "minimum": 1 },
        "relevantFiles": {
          "type": "array",
          "items": { "$ref": "#/$defs/fileIdentity" }
        }
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "freshDisposableWorkingDirectory",
        "workspaceRetained",
        "telemetryDisabledBeforeSpawn",
        "controlledPathSha256",
        "proseAbsentFromPath",
        "explicitSkillFlag",
        "ambientSkillsDisabled",
        "extensionsDisabled",
        "contextFilesDisabled",
        "savedSessionDisabled",
        "promptTemplatesDisabled",
        "themesDisabled",
        "allowedBuiltinTools"
      ],
      "properties": {
        "freshDisposableWorkingDirectory": { "const": true },
        "workspaceRetained": { "const": false },
        "telemetryDisabledBeforeSpawn": { "const": true },
        "controlledPathSha256": { "$ref": "#/$defs/sha256" },
        "proseAbsentFromPath": { "const": true },
        "explicitSkillFlag": { "const": true },
        "ambientSkillsDisabled": { "const": true },
        "extensionsDisabled": { "const": true },
        "contextFilesDisabled": { "const": true },
        "savedSessionDisabled": { "const": true },
        "promptTemplatesDisabled": { "const": true },
        "themesDisabled": { "const": true },
        "allowedBuiltinTools": { "const": ["ipython"] }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exitCode",
        "timedOut",
        "outputLimitExceeded",
        "stoppedAfterFirstAssistantError",
        "durationMs",
        "stdoutBytesObserved",
        "stderrBytesObserved",
        "capturedStdoutSha256",
        "capturedStderrSha256",
        "rawStdoutRetained",
        "sanitizedStderr"
      ],
      "properties": {
        "exitCode": { "type": ["integer", "null"] },
        "timedOut": { "type": "boolean" },
        "outputLimitExceeded": { "type": "boolean" },
        "stoppedAfterFirstAssistantError": { "type": "boolean" },
        "durationMs": { "type": "integer", "minimum": 0 },
        "stdoutBytesObserved": { "type": "integer", "minimum": 0 },
        "stderrBytesObserved": { "type": "integer", "minimum": 0 },
        "capturedStdoutSha256": { "$ref": "#/$defs/sha256" },
        "capturedStderrSha256": { "$ref": "#/$defs/sha256" },
        "rawStdoutRetained": { "const": false },
        "sanitizedStderr": { "type": "string", "maxLength": 8192 },
        "settlement": { "$ref": "#/$defs/settlement" }
      }
    },
    "toolAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "toolNames",
        "ipythonCallsObserved",
        "rlmRunCallsObserved",
        "directSubagentStartEvents",
        "subagentStartsObserved",
        "proseInvocationObserved",
        "legacyTelemetryAttemptObserved",
        "nonProviderNetworkToolObserved",
        "consequentialToolObserved",
        "toolArgumentsRetained"
      ],
      "properties": {
        "toolNames": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "ipythonCallsObserved": { "type": "integer", "minimum": 0 },
        "rlmRunCallsObserved": { "type": "integer", "minimum": 0 },
        "directSubagentStartEvents": { "type": "integer", "minimum": 0 },
        "subagentStartsObserved": { "type": "integer", "minimum": 0 },
        "proseInvocationObserved": { "type": "boolean" },
        "legacyTelemetryAttemptObserved": { "type": "boolean" },
        "nonProviderNetworkToolObserved": { "type": "boolean" },
        "consequentialToolObserved": { "type": "boolean" },
        "toolArgumentsRetained": { "const": false }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effectsPassed", "fileBodiesRetained"],
      "properties": {
        "effectsPassed": { "type": "boolean" },
        "auditError": { "type": "string", "maxLength": 8192 },
        "fileBodiesRetained": { "const": false },
        "fileCount": { "type": "integer", "minimum": 0 },
        "totalBytes": { "type": "integer", "minimum": 0 },
        "files": {
          "type": "array",
          "items": { "$ref": "#/$defs/fileIdentity" }
        },
        "telemetryDisabledEnvUnchanged": { "type": "boolean" },
        "rootProgramDigestExact": { "type": "boolean" },
        "runDirectoryCount": { "type": "integer", "minimum": 0 },
        "programCopyDigestExact": { "type": "boolean" },
        "stateFileCount": { "type": "integer", "minimum": 0 },
        "bindings": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/bindingIdentity" }
        },
        "bindingEffectCount": { "type": "integer", "minimum": 0 },
        "unexpectedEffectPaths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "subagentExecutionEvidenceCount": { "type": "integer", "minimum": 0 },
        "subagentExecutionProven": { "type": "boolean" }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "collectorClassification",
        "analyzerVersion",
        "jsonEventsParsed",
        "assistantTerminalAttempts",
        "usage",
        "cost",
        "costAuthoritativeForBilling",
        "reportedRoute",
        "requestedRouteReportedExactly",
        "sanitizedFailureDiagnostic"
      ],
      "properties": {
        "collectorClassification": { "$ref": "#/$defs/classification" },
        "classification": { "$ref": "#/$defs/classification" },
        "analyzerVersion": {
          "enum": [
            "direct-skill-effect-analyzer/2",
            "direct-skill-effect-analyzer/3"
          ]
        },
        "jsonEventsParsed": { "type": "integer", "minimum": 0 },
        "assistantTerminalAttempts": { "type": "integer", "minimum": 0 },
        "usage": { "$ref": "#/$defs/usage" },
        "cost": { "$ref": "#/$defs/cost" },
        "costAuthoritativeForBilling": { "const": false },
        "reportedRoute": { "$ref": "#/$defs/reportedRoute" },
        "requestedRouteReportedExactly": { "type": "boolean" },
        "sanitizedFailureDiagnostic": {
          "type": ["string", "null"],
          "maxLength": 8192
        }
      }
    },
    "claims": { "$ref": "#/$defs/claims" }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "fileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "byteLength", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/nonEmptyString" },
        "byteLength": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "bindingIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "byteLength",
        "candidateCount",
        "expectedTokenObserved",
        "bodyRetained"
      ],
      "properties": {
        "path": { "type": ["string", "null"] },
        "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "byteLength": { "type": ["integer", "null"], "minimum": 0 },
        "candidateCount": { "type": "integer", "minimum": 0 },
        "expectedTokenObserved": { "type": "boolean" },
        "bodyRetained": { "const": false }
      }
    },
    "executionCustody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "entryRelativePath",
        "entrySha256",
        "treeSha256",
        "treeFileCount",
        "treeTotalBytes",
        "interpreter",
        "exactSnapshottedBytesExecuted",
        "dynamicDependenciesClosed",
        "semanticAdmission"
      ],
      "properties": {
        "version": { "const": "snapshotted-launch-tree-v1" },
        "entryRelativePath": { "$ref": "#/$defs/nonEmptyString" },
        "entrySha256": { "$ref": "#/$defs/sha256" },
        "treeSha256": { "$ref": "#/$defs/sha256" },
        "treeFileCount": { "type": "integer", "minimum": 1 },
        "treeTotalBytes": { "type": "integer", "minimum": 1 },
        "interpreter": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": [
            "name",
            "sha256",
            "byteLength",
            "snapshotted",
            "supportFiles"
          ],
          "properties": {
            "name": { "$ref": "#/$defs/nonEmptyString" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "byteLength": { "type": "integer", "minimum": 1 },
            "snapshotted": { "const": true },
            "supportFiles": {
              "type": "array",
              "items": { "$ref": "#/$defs/fileIdentity" }
            }
          }
        },
        "exactSnapshottedBytesExecuted": { "const": true },
        "dynamicDependenciesClosed": { "const": false },
        "semanticAdmission": { "const": false }
      }
    },
    "settlement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enforcementVersion",
        "scope",
        "leaderReaped",
        "readersSettled",
        "streamsClosed",
        "originalProcessGroupEmpty",
        "detachedDescendantsContained",
        "strictContainmentClaimed"
      ],
      "properties": {
        "enforcementVersion": { "const": "bounded-original-group-v1" },
        "scope": {
          "enum": ["original-posix-process-group", "direct-process-only"]
        },
        "leaderReaped": { "type": ["boolean", "null"] },
        "readersSettled": { "type": ["boolean", "null"] },
        "streamsClosed": { "type": ["boolean", "null"] },
        "originalProcessGroupEmpty": { "type": ["boolean", "null"] },
        "detachedDescendantsContained": { "const": false },
        "strictContainmentClaimed": { "const": false }
      }
    },
    "classification": {
      "enum": [
        "old-skill-effect-pass",
        "filesystem-effect-pass-subagent-unproven",
        "old-skill-effect-fail",
        "harness-route-mismatch",
        "harness-unavailable",
        "policy-violation",
        "timeout",
        "output-limit"
      ]
    },
    "reportedRoute": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["provider", "model", "api"],
      "properties": {
        "provider": { "$ref": "#/$defs/nonEmptyString" },
        "model": { "$ref": "#/$defs/nonEmptyString" },
        "api": { "type": ["string", "null"] }
      }
    },
    "usage": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["source", "authoritativeForBilling", "attempts", "totals"],
      "properties": {
        "source": { "const": "harness-reported-message-usage" },
        "authoritativeForBilling": { "const": false },
        "attempts": { "type": "integer", "minimum": 1 },
        "totals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input", "output", "cacheRead", "cacheWrite", "totalTokens"],
          "properties": {
            "input": { "type": "number", "minimum": 0 },
            "output": { "type": "number", "minimum": 0 },
            "cacheRead": { "type": "number", "minimum": 0 },
            "cacheWrite": { "type": "number", "minimum": 0 },
            "totalTokens": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "cost": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "currency",
        "source",
        "authoritativeForBilling",
        "attempts",
        "totalUsd"
      ],
      "properties": {
        "currency": { "const": "USD" },
        "source": { "const": "harness-reported-message-usage" },
        "authoritativeForBilling": { "const": false },
        "attempts": { "type": "integer", "minimum": 1 },
        "totalUsd": { "type": "number", "minimum": 0 }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exploratoryOldSkillCompatibility",
        "interactiveTuiObserved",
        "currentSkillCompatibility",
        "strictWrapperAdmission",
        "semanticConformance",
        "proseComplete",
        "releaseEligible"
      ],
      "properties": {
        "exploratoryOldSkillCompatibility": { "const": "observation-only" },
        "interactiveTuiObserved": { "const": false },
        "currentSkillCompatibility": { "const": "unknown" },
        "strictWrapperAdmission": { "const": false },
        "semanticConformance": { "const": "unknown" },
        "proseComplete": { "const": "unknown" },
        "releaseEligible": { "const": false }
      }
    }
  }
}
