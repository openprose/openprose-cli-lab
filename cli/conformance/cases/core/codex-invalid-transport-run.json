    "fixedMonotonicMs": 0,
    "network": "denied"
  },
  "invocation": {
    "argv": ["--harness", "codex", "--transport", "rpc", "--output", "json", "run", "fixture.prose.md"],
    "cwd": "{{WORKSPACE}}",
    "environment": {}
  },
  "expected": {
    "exitCode": 20,
    "stdout": { "kind": "json", "schema": "openprose.runner-error/1" },
    "stderr": { "kind": "empty" },
    "startedHarness": false,
    "resultMatches": {
      "code": "TRANSPORT_UNSUPPORTED",
