{
  "schema": "openprose.runner-case/1",
  "id": "operations.harness-use-shadowed-environment",
  "summary": "Both products refuse to report a saved default when a conflicting environment harness would remain active.",
  "phase": 6,
  "tags": ["cli", "configuration", "agent-dx", "differential", "fail-closed", "saved-selection"],
  "controls": {
    "fixedInvocationId": "fixture-invocation-0001",
    "fixedTimestamp": "2025-01-01T00:00:00Z",
    "fixedMonotonicMs": 0,
    "network": "denied"
  },
  "invocation": {
    "argv": ["--output", "json", "cli", "harness", "use", "codex"],
    "cwd": "{{WORKSPACE}}",
    "environment": {
      "HOME": "{{WORKSPACE}}/home",
      "XDG_CONFIG_HOME": "{{WORKSPACE}}/config",
      "PROSE_HARNESS": "claude"
    }
  },
  "expected": {
    "exitCode": 2,
    "stdout": { "kind": "json", "schema": "openprose.runner-error/1" },
    "stderr": { "kind": "empty" },
    "startedHarness": false,
    "resultMatches": {
      "code": "CONFIG_INVALID",
      "boundary": "configuration",
      "details": {
        "selectedHarness": "codex",
        "effectiveHarness": "claude",
        "effectiveHarnessSource": "environment",
        "reason": "Saved default codex would not be active because the higher-precedence environment harness selects claude; remove that override or select the same harness."
      }
    }
  }
}
