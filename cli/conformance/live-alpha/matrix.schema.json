{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openprose.org/cli/v4/functional-alpha-live-matrix.schema.json",
  "title": "OpenProse target-bound functional-alpha live matrix report v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "target", "requiredSurfaces", "requiredHarnesses", "cellCount", "common", "surfaces", "harnesses", "cells", "claims"],
  "properties": {
    "schema": { "const": "openprose.functional-alpha-live-matrix/4" },
    "status": { "const": "pass" },
    "target": { "$ref": "#/$defs/targetExecution" },
    "requiredSurfaces": {
      "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true,
      "items": { "$ref": "#/$defs/surface" }
    },
    "requiredHarnesses": {
      "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
      "items": { "$ref": "#/$defs/harness" }
    },
    "cellCount": { "type": "integer", "minimum": 1, "maximum": 12 },
    "common": {
      "type": "object", "additionalProperties": false,
      "required": ["runnerBuild", "program", "taskSha256", "image", "imageManifestReleaseEligible", "semanticStatus", "terminalSchemaSha256", "terminalEnvelopeDigestSha256"],
      "properties": {
        "runnerBuild": {
          "type": "object", "additionalProperties": false,
          "required": ["version", "commit"],
          "properties": {
            "version": { "$ref": "#/$defs/semver" },
            "commit": { "type": "string", "pattern": "^[A-Za-z0-9._+-]{1,128}$" }
          }
        },
        "program": { "$ref": "#/$defs/contentIdentity" },
        "taskSha256": { "$ref": "#/$defs/sha256" },
        "image": { "$ref": "#/$defs/image" },
        "imageManifestReleaseEligible": { "type": "boolean" },
        "semanticStatus": { "const": "not-applicable" },
        "terminalSchemaSha256": { "$ref": "#/$defs/sha256" },
        "terminalEnvelopeDigestSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "surfaces": {
      "type": "array", "minItems": 1, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["surface", "candidateClosure", "runner"],
        "properties": {
          "surface": { "$ref": "#/$defs/surface" },
          "candidateClosure": { "$ref": "#/$defs/candidateClosure" },
          "runner": { "$ref": "#/$defs/runner" }
        }
      }
    },
    "harnesses": {
      "type": "array", "minItems": 1, "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["harness", "custody", "invocation", "adapterId", "transport", "promptPlacement", "isolation", "harnessVersion", "admittedVersions", "repairCommand", "adapterDescriptorSha256"],
        "properties": {
          "harness": { "$ref": "#/$defs/harness" },
          "custody": { "$ref": "#/$defs/harnessCustody" },
          "invocation": { "$ref": "#/$defs/invocation" },
          "adapterId": { "enum": ["prime/rpc", "omp/rpc", "codex/exec-json", "claude/print-stream-json"] },
          "transport": { "enum": ["rpc", "exec-json", "print-stream-json"] },
          "promptPlacement": { "enum": ["developer", "system-append", "user-prefix-framed"] },
          "isolation": { "enum": ["advisory", "unsupported"] },
          "harnessVersion": { "type": "string", "minLength": 1 },
          "admittedVersions": { "$ref": "#/$defs/admittedVersions" },
          "repairCommand": { "$ref": "#/$defs/repairCommand" },
          "adapterDescriptorSha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "cells": {
      "type": "array", "minItems": 1, "maxItems": 12,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["surface", "harness", "targetPlatform", "evidenceSha256", "candidateClosure", "harnessCustodySha256", "invocation", "runnerName", "harnessVersion", "admittedVersions", "repairCommand", "durationMs"],
        "properties": {
          "surface": { "$ref": "#/$defs/surface" },
          "harness": { "$ref": "#/$defs/harness" },
          "targetPlatform": { "$ref": "#/$defs/platformId" },
          "evidenceSha256": { "$ref": "#/$defs/sha256" },
          "candidateClosure": { "$ref": "#/$defs/candidateClosure" },
          "harnessCustodySha256": { "$ref": "#/$defs/sha256" },
          "invocation": { "$ref": "#/$defs/invocation" },
          "runnerName": { "enum": ["rust", "bun"] },
          "harnessVersion": { "type": "string", "minLength": 1 },
          "admittedVersions": { "$ref": "#/$defs/admittedVersions" },
          "repairCommand": { "$ref": "#/$defs/repairCommand" },
          "durationMs": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "claims": {
      "const": {
        "authority": "aggregate-of-candidate-reported-smoke",
        "crossSurfaceEquality": "candidate-closure-digest-and-settlement",
        "cliSelectionConfigIsolation": "owned-temporary-root-observed",
        "harnessConfigurationIsolation": "recipe-reported-per-harness",
        "reliability": "not-measured",
        "failedAttemptRetention": "outside-this-pass-matrix",
        "strictVersionAdmission": "exact-recipe-list-revalidated",
        "targetBinding": "exact-node-runtime-probe-reauthenticated",
        "harnessByteBinding": "independent-path-selection-and-bounded-declared-package-runtime-bytes-reauthenticated",
        "modelAndAuthRouteBinding": "driver-input-category-only",
        "ambientHarnessState": "external-unbound",
        "custodyThreatModel": "same-user-persistent-mutation-detection",
        "coverage": "exact-declared-target-surface-harness-product",
        "openProseExecuted": false,
        "semanticConformance": "not-applicable",
        "providerCredentialCharged": "unverified",
        "releaseEligible": false
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "target": { "properties": { "platformId": { "const": "darwin-x64" } } } } },
      "then": { "properties": { "requiredHarnesses": { "items": { "const": "codex" } } } }
    },
    {
      "if": { "properties": { "target": { "properties": { "platformId": { "const": "linux-x64-gnu" } } } } },
      "then": { "properties": { "requiredHarnesses": { "items": { "enum": ["codex", "omp"] } } } }
    },
    {
      "if": { "properties": { "target": { "properties": { "platformId": { "const": "linux-arm64-gnu" } } } } },
      "then": { "properties": { "requiredHarnesses": { "items": { "const": "codex" } } } }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$" },
    "admittedVersions": {
      "oneOf": [
        { "const": ["0.7.0", "0.8.1"] },
        { "const": ["18.0.9"] },
        { "const": ["0.149.0-alpha.4.1"] },
        { "const": ["2.1.243"] }
      ]
    },
    "repairCommand": {
      "enum": [
        "curl -fsSL https://app.primeintellect.ai/prime-agent/install.sh | sh -s -- 0.8.1",
        "npm install --global bun@1.3.14 @oh-my-pi/pi-coding-agent@18.0.9",
        "npm install --global @openai/codex@0.149.0-alpha.4.1",
        "npm install --global @anthropic-ai/claude-code@2.1.243"
      ]
    },
    "surface": { "enum": ["rust", "bun", "npm"] },
    "harness": { "enum": ["prime", "omp", "codex", "claude"] },
    "platformId": { "enum": ["darwin-arm64", "darwin-x64", "linux-x64-gnu", "linux-arm64-gnu"] },
    "targetExecution": {
      "type": "object", "additionalProperties": false,
      "required": ["authority", "platformId", "platform", "architecture", "libc", "node"],
      "properties": {
        "authority": { "const": "exact-node-runtime-probe" },
        "platformId": { "$ref": "#/$defs/platformId" },
        "platform": { "enum": ["darwin", "linux"] },
        "architecture": { "enum": ["arm64", "x64"] },
        "libc": { "enum": [null, "gnu"] },
        "node": {
          "type": "object", "additionalProperties": false,
          "required": ["byteLength", "sha256"],
          "properties": {
            "byteLength": { "type": "integer", "minimum": 1 },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "platformId": { "pattern": "^darwin-" } } },
          "then": { "properties": { "platform": { "const": "darwin" }, "libc": { "const": null } } }
        },
        {
          "if": { "properties": { "platformId": { "pattern": "^linux-" } } },
          "then": { "properties": { "platform": { "const": "linux" }, "libc": { "const": "gnu" } } }
        },
        {
          "if": { "properties": { "platformId": { "pattern": "-arm64(?:-|$)" } } },
          "then": { "properties": { "architecture": { "const": "arm64" } } }
        },
        {
          "if": { "properties": { "platformId": { "pattern": "-x64(?:-|$)" } } },
          "then": { "properties": { "architecture": { "const": "x64" } } }
        }
      ]
    },
    "contentIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["byteLength", "sha256"],
      "properties": {
        "byteLength": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "harnessPackage": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "root", "manifest", "tree"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "version": { "$ref": "#/$defs/semver" },
        "root": { "type": "boolean" },
        "manifest": { "$ref": "#/$defs/contentIdentity" },
        "tree": {
          "type": "object", "additionalProperties": false,
          "required": ["memberCount", "totalByteLength", "sha256"],
          "properties": {
            "memberCount": { "type": "integer", "minimum": 1, "maximum": 65536 },
            "totalByteLength": { "type": "integer", "minimum": 1, "maximum": 2147483648 },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    },
    "harnessCustody": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "harness", "commandName", "route", "distributionKind", "launcherKind", "entrypoint", "runtime", "packages", "dependencyGraph", "fileCount", "totalByteLength", "externalAuthorities", "aggregateSha256"],
      "properties": {
        "schema": { "const": "openprose.harness-byte-custody/1" },
        "harness": { "$ref": "#/$defs/harness" },
        "commandName": { "enum": ["prime-agent", "omp", "codex", "claude"] },
        "route": {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "linkCount"],
          "properties": {
            "kind": { "enum": ["direct", "symlink-chain"] },
            "linkCount": { "type": "integer", "minimum": 0, "maximum": 32 }
          }
        },
        "distributionKind": { "enum": ["native", "npm-package", "dev-shell-package"] },
        "launcherKind": { "enum": ["native", "env-shebang", "shell-shebang"] },
        "entrypoint": { "$ref": "#/$defs/contentIdentity" },
        "runtime": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object", "additionalProperties": false,
              "required": ["name", "version", "launcher", "executable"],
              "properties": {
                "name": { "enum": ["node", "bun"] },
                "version": { "$ref": "#/$defs/semver" },
                "launcher": {
                  "type": "object", "additionalProperties": false,
                  "required": ["name", "executable"],
                  "properties": {
                    "name": { "enum": ["env", "sh"] },
                    "executable": { "$ref": "#/$defs/contentIdentity" }
                  }
                },
                "executable": { "$ref": "#/$defs/contentIdentity" }
              }
            }
          ]
        },
        "packages": { "type": "array", "maxItems": 512, "items": { "$ref": "#/$defs/harnessPackage" } },
        "dependencyGraph": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object", "additionalProperties": false,
              "required": ["edgeCount", "missingOptionalCount", "sha256"],
              "properties": {
                "edgeCount": { "type": "integer", "minimum": 0 },
                "missingOptionalCount": { "type": "integer", "minimum": 0 },
                "sha256": { "$ref": "#/$defs/sha256" }
              }
            }
          ]
        },
        "fileCount": { "type": "integer", "minimum": 1, "maximum": 65536 },
        "totalByteLength": { "type": "integer", "minimum": 1, "maximum": 2147483648 },
        "externalAuthorities": { "const": ["dynamic-undeclared-imports", "native-os-loader-libraries", "interpreter-resource-files", "ambient-harness-config-plugins-skills", "cached-account-provider-state", "provider-side-model-routing"] },
        "aggregateSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "invocation": {
      "type": "object", "additionalProperties": false,
      "required": ["model", "authRoute"],
      "properties": {
        "model": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+@-]{0,255}$" },
        "authRoute": {
          "type": "object", "additionalProperties": false,
          "required": ["profile", "category"],
          "properties": {
            "profile": { "enum": ["prime-harness-login", "omp-harness-login", "cached-chatgpt-login", "claude-subscription", "anthropic", "openai", "openrouter", "google", "github-copilot", "aws-bedrock", "openai-api-key", "codex-access-token"] },
            "category": { "enum": ["harness-login", "provider-api-key", "provider-access-token", "cloud-provider-credentials"] }
          }
        }
      }
    },
    "closureMember": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "byteLength", "sha256"],
      "properties": {
        "role": { "enum": ["executable", "launcher", "meta-package-json", "platform-package-json", "native-executable"] },
        "byteLength": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "nodeIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["byteLength", "sha256", "platform", "architecture", "libc", "platformId"],
      "properties": {
        "byteLength": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "platform": { "enum": ["darwin", "linux", "win32"] },
        "architecture": { "enum": ["arm64", "x64"] },
        "libc": { "enum": [null, "gnu", "musl"] },
        "platformId": { "type": "string", "pattern": "^(darwin-(arm64|x64)|linux-(arm64|x64)-(gnu|musl)|win32-(arm64|x64))$" }
      }
    },
    "npmClosureMetadata": {
      "type": "object", "additionalProperties": false,
      "required": ["platformId", "metaPackage", "metaVersion", "platformPackage", "platformVersion", "binaryRelativePath", "declaredBinaryByteLength", "declaredBinarySha256", "node"],
      "properties": {
        "platformId": { "type": "string", "pattern": "^(darwin-(arm64|x64)|linux-(arm64|x64)-(gnu|musl)|win32-(arm64|x64))$" },
        "metaPackage": { "const": "@openprose/prose-cli" },
        "metaVersion": { "$ref": "#/$defs/semver" },
        "platformPackage": { "type": "string", "pattern": "^@openprose/prose-cli-(darwin-(arm64|x64)|linux-(arm64|x64)-(gnu|musl)|win32-(arm64|x64))$" },
        "platformVersion": { "$ref": "#/$defs/semver" },
        "binaryRelativePath": { "enum": ["bin/prose", "bin/prose.exe"] },
        "declaredBinaryByteLength": { "type": "integer", "minimum": 1 },
        "declaredBinarySha256": { "$ref": "#/$defs/sha256" },
        "node": { "$ref": "#/$defs/nodeIdentity" }
      }
    },
    "candidateClosure": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["schema", "kind", "members"],
          "properties": {
            "schema": { "const": "openprose.candidate-closure/1" },
            "kind": { "const": "direct" },
            "members": {
              "type": "array", "minItems": 1, "maxItems": 1,
              "items": { "$ref": "#/$defs/closureMember" },
              "prefixItems": [{ "properties": { "role": { "const": "executable" } } }]
            }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["schema", "kind", "members", "npm"],
          "properties": {
            "schema": { "const": "openprose.candidate-closure/1" },
            "kind": { "const": "npm" },
            "members": {
              "type": "array", "minItems": 4, "maxItems": 4,
              "items": { "$ref": "#/$defs/closureMember" },
              "prefixItems": [
                { "properties": { "role": { "const": "launcher" } } },
                { "properties": { "role": { "const": "meta-package-json" } } },
                { "properties": { "role": { "const": "platform-package-json" } } },
                { "properties": { "role": { "const": "native-executable" } } }
              ]
            },
            "npm": { "$ref": "#/$defs/npmClosureMetadata" }
          }
        }
      ]
    },
    "runner": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "commit"],
      "properties": {
        "name": { "enum": ["rust", "bun"] },
        "version": { "$ref": "#/$defs/semver" },
        "commit": { "type": "string", "pattern": "^[A-Za-z0-9._+-]{1,128}$" }
      }
    },
    "image": {
      "type": "object", "additionalProperties": false,
      "required": ["formatVersion", "version", "sha256"],
      "properties": {
        "formatVersion": { "const": "openprose.skill-runtime-image/1" },
        "version": { "const": "echo-v0" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
