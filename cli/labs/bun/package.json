{
  "name": "@openprose/prose-cli-bun-labs",
  "version": "0.0.0-research",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "check": "bun run typecheck && bun test",
    "typecheck": "bunx tsc --noEmit",
    "compile": "bun run ./scripts/compile-all.ts",
    "compile:codex": "bun build --compile --minify --target=bun-darwin-arm64 ./src/compile/codex.ts --outfile ./dist/codex-lab",
    "compile:claude": "bun build --compile --minify --target=bun-darwin-arm64 ./src/compile/claude.ts --outfile ./dist/claude-lab",
    "compile:pi": "bun run ./scripts/compile-pi.ts",
    "compile:omp": "bun run ./scripts/compile-omp.ts",
    "package:smoke": "bun run ./scripts/package-smoke.ts",
    "research": "bun run ./scripts/research.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.250",
    "@anthropic-ai/claude-agent-sdk-darwin-arm64": "0.3.250",
    "@mariozechner/pi-agent-core": "0.73.1",
    "@mariozechner/pi-ai": "0.73.1",
    "@mariozechner/pi-coding-agent": "0.73.1",
    "@oh-my-pi/pi-ai": "18.0.8",
    "@oh-my-pi/pi-coding-agent": "18.0.8",
    "@openai/codex-sdk": "0.150.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  }
}
