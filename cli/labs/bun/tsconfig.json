{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowJs": false,
    "exactOptionalPropertyTypes": true,
    "lib": ["ES2024"],
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2024",
    "types": ["bun"]
  },
  "include": ["scripts/**/*.ts", "src/**/*.ts", "test/**/*.ts"]
}
